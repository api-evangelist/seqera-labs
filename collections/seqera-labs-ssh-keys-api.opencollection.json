{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions ssh-keys API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "ssh-keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List SSH keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ssh-keys",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the list of all SSH public keys for the authenticated user."
        },
        {
          "info": {
            "name": "Create SSH key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/ssh-keys",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new SSH public key with the details in the given request body."
        },
        {
          "info": {
            "name": "Validate SSH key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ssh-keys/validate/key",
            "params": [
              {
                "name": "key",
                "value": "",
                "type": "query",
                "description": "SSH key to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Confirms the availability of the given key for a SSH key in the user context."
        },
        {
          "info": {
            "name": "Validate SSH key name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ssh-keys/validate/name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "SSH key name to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Confirms the availability of the given name for a SSH key in the user context."
        },
        {
          "info": {
            "name": "Describe SSH key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/ssh-keys/:keyId",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "SSH key numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of an SSH public key by its ID."
        },
        {
          "info": {
            "name": "Delete SSH key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/ssh-keys/:keyId",
            "params": [
              {
                "name": "keyId",
                "value": "",
                "type": "path",
                "description": "SSH key numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the given SSH public key by its ID."
        }
      ]
    }
  ],
  "bundled": true
}