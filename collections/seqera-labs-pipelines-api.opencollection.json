{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions pipelines API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "pipelines",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List pipelines",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines",
            "params": [
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Additional attribute values to include in the response (`labels`, `optimized` status, `computeEnv`). Returns an empty value (`labels: null`, etc.) if omitted."
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Pagination max results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query",
                "description": "Sort field (`NAME` by default)"
              },
              {
                "name": "sortDir",
                "value": "",
                "type": "query",
                "description": "Sort direction (`ASCENDING` by default)"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter search parameter"
              },
              {
                "name": "visibility",
                "value": "",
                "type": "query",
                "description": "Filter visibility parameter"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all available pipelines in a user context, enriched by `attributes`. Append `workspaceId` to list pipelines in a workspace context."
        },
        {
          "info": {
            "name": "Create pipeline",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/pipelines",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new pipeline in a user context. Append `?workspaceId` to create the pipeline in a workspace context."
        },
        {
          "info": {
            "name": "Describe remote pipeline repository",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines/info",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Pipeline repository name or URL"
              },
              {
                "name": "revision",
                "value": "",
                "type": "query",
                "description": "Pipeline revision"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "mainScript",
                "value": "",
                "type": "query",
                "description": "Pipeline alternative main.nf"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of a remote Nextflow pipeline Git repository. Append the repository name or full URL with `?name`."
        },
        {
          "info": {
            "name": "List user pipeline repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines/repositories",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists known Nextflow pipeline Git repositories, extracted from existing runs. Append `?workspaceId` to list repositories in a workspace context."
        },
        {
          "info": {
            "name": "Validate pipeline name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines/validate",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "orgId",
                "value": "",
                "type": "query",
                "description": "Organization numeric identifier"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Pipeline name to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Confirms the validity of the given pipeline `name` in a user context. Append `?name=<your_pipeline_name>`. Append `?workspaceId` to validate the name in a workspace context."
        },
        {
          "info": {
            "name": "Describe pipeline",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines/:pipelineId",
            "params": [
              {
                "name": "pipelineId",
                "value": "",
                "type": "path",
                "description": "Pipeline numeric identifier"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Additional attribute values to include in the response (`labels`, `optimized` status, `computeEnv`). Returns an empty value (`labels: null`, etc.) if omitted."
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "sourceWorkspaceId",
                "value": "",
                "type": "query",
                "description": "Source workspace numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of the pipeline identified by the given `pipelineId`, enriched by `attributes`."
        },
        {
          "info": {
            "name": "Update pipeline (default version)",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/pipelines/:pipelineId",
            "params": [
              {
                "name": "pipelineId",
                "value": "",
                "type": "path",
                "description": "Pipeline numeric identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the details of the pipeline identified by the given `pipelineId`.\n            **Note**: If `labelIds` is `null`, empty, or omitted, existing pipeline labels are removed.\n            Include `labelIds: [<label-id-1>,<label-id-2>]` to override existing labels. Labels to be preserved must be included.\n            To append a list of labels to multiple pipelines, use `/pipelines/labels/add`."
        },
        {
          "info": {
            "name": "Delete pipeline",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/pipelines/:pipelineId",
            "params": [
              {
                "name": "pipelineId",
                "value": "",
                "type": "path",
                "description": "Pipeline numeric identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the pipeline identified by the given `pipelineId`."
        },
        {
          "info": {
            "name": "Describe pipeline launch",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines/:pipelineId/launch",
            "params": [
              {
                "name": "pipelineId",
                "value": "",
                "type": "path",
                "description": "Pipeline numeric identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "sourceWorkspaceId",
                "value": "",
                "type": "query",
                "description": "Source workspace numeric identifier"
              },
              {
                "name": "versionId",
                "value": "",
                "type": "query",
                "description": "Pipeline version identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the launch details of the pipeline identified by the given `pipelineId`."
        },
        {
          "info": {
            "name": "Describe pipeline schema",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipelines/:pipelineId/schema",
            "params": [
              {
                "name": "pipelineId",
                "value": "",
                "type": "path",
                "description": "Pipeline numeric identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "sourceWorkspaceId",
                "value": "",
                "type": "query",
                "description": "Source workspace numeric identifier"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Additional attribute values to include in the response: `schema` returns the pipeline schema, `params` returns the pipeline config. Returns all if `attributes` is omitted."
              },
              {
                "name": "versionId",
                "value": "",
                "type": "query",
                "description": "Pipeline version identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the pipeline schema of the pipeline identified by the given `pipelineId`, enriched by `attributes`.\n            `200 - OK` responses include the pipeline schema.\n            `204 - OK` responses indicate a successful request, with no saved schema found for the given pipeline ID.\n            "
        }
      ]
    }
  ],
  "bundled": true
}