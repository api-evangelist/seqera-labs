                "description": "User name to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Check that the user name is valid"
        },
        {
          "info": {
            "name": "Describe a user entity",
