{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions workflows API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/workflow",
            "params": [
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Additional attribute values to include in the response (`labels`, `optimized` status). Returns an empty value (`labels: null`) if omitted."
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Pagination max results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter search parameter"
              },
              {
                "name": "includeTotalSize",
                "value": "",
                "type": "query",
                "description": "Include total size in the response"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all workflow records, enriched with `attributes`. Append `?workspaceId` to list workflow records in a workspace context."
        },
        {
          "info": {
            "name": "Delete workflows",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/workflow/delete",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "Force the deletion even if any workflows are active"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the workflow records identified by the given list of `workflowIds`."
        },
        {
          "info": {
            "name": "Launch workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/workflow/launch",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "sourceWorkspaceId",
                "value": "",
                "type": "query",
                "description": "Source workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Submits a workflow execution."
        },
        {
          "info": {
            "name": "Generates a random name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/workflow/random-name",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generates a random name"
        },
        {
          "info": {
            "name": "Validate run name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/workflow/validate",
            "params": [
              {
                "name": "runName",
                "value": "",
