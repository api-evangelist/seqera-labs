{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions orgs API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "orgs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List organizations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs",
            "params": [
              {
                "name": "role",
                "value": "",
                "type": "query",
                "description": "Organization user role identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all available organizations in a user context."
        },
        {
          "info": {
            "name": "Create organization",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/orgs",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new organization."
        },
        {
          "info": {
            "name": "Validate organization name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/validate",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Organization name to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Confirms the validity of the given organization name. Append `?name=<your_org_name>`."
        },
        {
          "info": {
            "name": "Describe organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "Update organization",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/orgs/:orgId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the details of the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "Delete organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orgs/:orgId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "List organization collaborators",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/collaborators",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Pagination max results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter search parameter"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists the collaborators of the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "List IdP groups for an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/idp-groups",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the IdP group catalog for the organization, including both SCIM-pushed and manually entered groups."
        },
        {
          "info": {
            "name": "Manually add an IdP group to the catalog",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/orgs/:orgId/idp-groups",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Adds a group entry to the IdP group catalog via manual entry. The admin must enter the exact claim value their IdP sends in the groups claim."
        },
        {
          "info": {
            "name": "Remove an IdP group from the catalog",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orgs/:orgId/idp-groups/:groupId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "groupId",
                "value": "",
                "type": "path",
                "description": "IdP group numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Removes a manually-entered group from the catalog. SCIM-managed groups cannot be deleted via this endpoint."
        },
        {
          "info": {
            "name": "List organization members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/members",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Pagination max results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter search parameter"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists the members of the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "Add organization member",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/orgs/:orgId/members/add",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Adds a new member to the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "Leave organization",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orgs/:orgId/members/leave",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Removes the requesting user from the organization identified by the given `orgId`."
        },
        {
          "info": {
            "name": "Delete member",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orgs/:orgId/members/:memberId",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "Organization member numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the member identified by the given `memberId`."
        },
        {
          "info": {
            "name": "Update member role",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/orgs/:orgId/members/:memberId/role",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "memberId",
                "value": "",
                "type": "path",
                "description": "Organization member numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the role of the member identified by the given `memberId`."
        },
        {
          "info": {
            "name": "Describe organization quotas",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/quotas",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Optional list of quota names to include"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of the organization quotas identified by the given `orgId`."
        },
        {
          "info": {
            "name": "View SCIM configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/scim/config",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the SCIM configuration for the organization, including token metadata, group count, and SSO state. Accessible to all org members (read access)."
        },
        {
          "info": {
            "name": "Generate a SCIM bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/orgs/:orgId/scim/token",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Generates a new SCIM bearer token for the organization. If an active token already exists it is revoked first. The plaintext token is returned only once."
        },
        {
          "info": {
            "name": "Revoke the active SCIM bearer token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/orgs/:orgId/scim/token",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revokes the active SCIM bearer token for the organization. Returns 404 if no active token exists."
        },
        {
          "info": {
            "name": "Rotate the SCIM bearer token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/orgs/:orgId/scim/token/rotate",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revokes the current active token and generates a new one. The new plaintext token is returned only once."
        },
        {
          "info": {
            "name": "List all user roles and permissions in an organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/users/:userId/roles",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "User numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List all user roles and permissions in an organization; also list the sources of those roles (via team assignment or direct user assignment)."
        }
      ]
    }
  ],
  "bundled": true
}