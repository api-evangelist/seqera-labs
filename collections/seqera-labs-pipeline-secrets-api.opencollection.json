{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions pipeline-secrets API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "pipeline-secrets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List pipeline secrets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipeline-secrets",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all available pipeline secrets in a user context. Append `?workspaceId` to list secrets in a workspace context."
        },
        {
          "info": {
            "name": "Create pipeline secret",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/pipeline-secrets",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new pipeline secret in the user context. Append `?workspaceId` to create the secret in a workspace context."
        },
        {
          "info": {
            "name": "Validate secret name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipeline-secrets/validate",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Secret name to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Confirms the validity of the given pipeline secret name in a user context. Append `?name=<your_secret_name>`. Append `?workspaceId` to validate the name in a workspace context."
        },
        {
          "info": {
            "name": "Describe pipeline secret",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/pipeline-secrets/:secretId",
            "params": [
              {
                "name": "secretId",
                "value": "",
                "type": "path",
                "description": "Secret numeric identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of the pipeline secret identified by the given `secretId`."
        },
