          "info": {
            "name": "Update secret",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/pipeline-secrets/:secretId",
            "params": [
              {
                "name": "secretId",
                "value": "",
                "type": "path",
                "description": "Secret numeric identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
