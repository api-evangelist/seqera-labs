          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/orgs/:orgId/teams",
            "params": [
              {
                "name": "orgId",
                "value": "",
                "type": "path",
                "description": "Organization numeric identifier"
              },
              {
                "name": "max",
                "value": "",
                "type": "query",
                "description": "Pagination max results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Pagination offset"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter search parameter"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
