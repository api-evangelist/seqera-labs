            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Check that the given run name of a workflow has a valid format. When the session ID is given: check that no other workflow in the system exists with the combination of both elements."
        },
        {
          "info": {
            "name": "Describe workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/workflow/:workflowId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "attributes",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of attributes to retrieve. Returns an empty value for each attribute not specified."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of the workflow record associated with the given `workflowId`."
        },
        {
          "info": {
            "name": "Apply a partial update to the workflow-extension metadata for the given Workflow ID",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/workflow/:workflowId",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates only the workflow-extension store; never a core workflow field. Designed to carry workflow-extension attributes generally so future fields reuse this operation. Returns the updated workflow representation."
        },
        {
          "info": {
            "name": "Delete the Workflow entity with the given ID",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/workflow/:workflowId",
            "params": [
