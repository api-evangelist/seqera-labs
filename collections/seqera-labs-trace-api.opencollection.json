{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions trace API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "trace",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create workflow execution trace",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/trace/create",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new workflow execution trace."
        },
        {
          "info": {
            "name": "Signal workflow execution start",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/trace/:workflowId/begin",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the workflow execution trace for the given `workflowId`."
        },
        {
          "info": {
            "name": "Signal workflow execution completion",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/trace/:workflowId/complete",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the workflow execution trace for the given `workflowId`."
        },
        {
          "info": {
            "name": "Signal workflow execution heartbeat",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/trace/:workflowId/heartbeat",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update the workflow execution trace heartbeat for the given `workflowId` to signal that execution is ongoing."
        },
        {
          "info": {
            "name": "Store workflow task execution metadata",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/trace/:workflowId/progress",
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Store the execution metadata for one or more tasks in the given `workflowId`."
        }
      ]
    }
  ],
  "bundled": true
}