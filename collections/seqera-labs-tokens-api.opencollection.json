{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions tokens API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "tokens",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List tokens",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/tokens",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the list of all available API access tokens."
        },
        {
          "info": {
            "name": "Create token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/tokens",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates an API access token with the details in the given request body."
        },
        {
          "info": {
            "name": "Delete all user tokens",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tokens/delete-all",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes all API access tokens in the user context."
        },
        {
          "info": {
            "name": "Delete token",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/tokens/:tokenId",
            "params": [
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "Token numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the given API access token ID."
        }
      ]
    }
  ],
  "bundled": true
}