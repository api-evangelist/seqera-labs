{
  "opencollection": "1.0.0",
  "info": {
    "name": "Seqera actions credentials API",
    "version": "1.181.0"
  },
  "items": [
    {
      "info": {
        "name": "credentials",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/credentials",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "platformId",
                "value": "",
                "type": "query",
                "description": "Platform string identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Lists all available credentials in a user context. Append `?workspaceId` to list credentials in a workspace context, and `?platformId` to filter credentials by computing platform."
        },
        {
          "info": {
            "name": "Create credentials",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/credentials",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "useExternalId",
                "value": "",
                "type": "query",
                "description": "Generate External ID for AWS credentials (requires IAM Role ARN)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates new credentials in a user context. Append `?workspaceId` to create the credentials in a workspace context. For AWS credentials with IAM Role ARN, append `?useExternalId=true` to generate a Platform-managed External ID."
        },
        {
          "info": {
            "name": "Validate credential name",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/credentials/validate",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Credentials name to validate"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Validates the given credentials name. Append `?name=<your_credential_name>`."
        },
        {
          "info": {
            "name": "Describe credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/credentials/:credentialsId",
            "params": [
              {
                "name": "credentialsId",
                "value": "",
                "type": "path",
                "description": "Credentials string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the details of the credentials identified by the given `credentialsId`."
        },
        {
          "info": {
            "name": "Update credentials",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/credentials/:credentialsId",
            "params": [
              {
                "name": "credentialsId",
                "value": "",
                "type": "path",
                "description": "Credentials string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "useExternalId",
                "value": "",
                "type": "query",
                "description": "Generate External ID for AWS credentials (requires IAM Role ARN)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates the details of the credentials identified by the given `credentialsId`. For AWS credentials with IAM Role ARN, append `?useExternalId=true` to generate a Platform-managed External ID."
        },
        {
          "info": {
            "name": "Delete credentials",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/credentials/:credentialsId",
            "params": [
              {
                "name": "credentialsId",
                "value": "",
                "type": "path",
                "description": "Credentials string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "checked",
                "value": "",
                "type": "query",
                "description": "If set credentials deletion will be blocked by running jobs that depend on them"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes the credentials identified by the given `credentialsId`."
        },
        {
          "info": {
            "name": "Get encrypted credentials",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/credentials/:credentialsId/keys",
            "params": [
              {
                "name": "credentialsId",
                "value": "",
                "type": "path",
                "description": "Credentials string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "pairingId",
                "value": "",
                "type": "query",
                "description": "Encryption key string identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the encrypted keys for the credentials identified by the given `credentialsId`."
        },
        {
          "info": {
            "name": "Validate credentials against their cloud provider and report the outcome",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/credentials/:credentialsId/validate",
            "params": [
              {
                "name": "credentialsId",
                "value": "",
                "type": "path",
                "description": "Credentials string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "When true, skip the probe and force the credential (INVALID only) to AVAILABLE. Rejected with 409 for any other status."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Validate credentials against their cloud provider and report the outcome"
        }
      ]
    }
  ],
  "bundled": true
}