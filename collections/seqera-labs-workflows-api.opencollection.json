                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow string identifier"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "query",
                "description": "Workspace numeric identifier"
              },
              {
                "name": "force",
                "value": "",
                "type": "query",
                "description": "Force the deletion even if the workflow is active"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete the Workflow entity with the given ID"
        },
